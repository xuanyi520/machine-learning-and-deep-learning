    "lr = 0.01                                         # 学习率：每一步迈多大\n",
    "losses = []                                       # 日记本：存每一步的 loss，后面画曲线用\n",
    "\n",
    "# 3. 训练循环\n",
    "for epoch in range(1000):\n",
    "    y_pred = w * x + b                            # ① 前向：先猜一个\n",
    "    error = y_pred - y                            # 猜的值和真实值差多少\n",
    "    loss = (error ** 2).mean()                    # ② 损失：误差平方后求平均（MSE）= 当前海拔\n",
    "    losses.append(loss.item())                    # 记下海拔；.item() 把 tensor 变成普通数字\n",
