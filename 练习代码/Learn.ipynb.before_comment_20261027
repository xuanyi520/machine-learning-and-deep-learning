   "source": [
    "import torch\n",
    "import torch.nn as nn\n",
    "from sklearn.datasets import make_moons\n",
    "\n",
    "x,y = make_moons(n_samples=1000,noise=0.1,random_state=42)\n",
    "x = torch.tensor(x,dtype=torch.float32)\n",
    "y = torch.tensor(y,dtype=torch.float32).unsqueeze(1)\n",
    "\n",
    "class withReLU(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        #self.net是名字\n",
    "        #nn.Sequential()是一个按顺序执行的容器\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(2,32),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(32,32),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(32,1),\n",
    "            nn.Sigmoid()\n",
    "        )\n",
    "\n",
    "    def forward(self,x):\n",
    "        return self.net(x)\n",
    "\n",
    "class NoReLU(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(2,32),\n",
    "            nn.Linear(32,32),\n",
    "            nn.Linear(32,1),\n",
    "            nn.Sigmoid()\n",
    "        )\n",
    "    def forward(self,x):\n",
    "        return self.net(x)\n",
    "\n",
    "for name,cls in [('有ReLu',withReLU),('无ReLU',NoReLU)]:\n",
    "    model = cls()\n",
    "    opt = torch.optim.Adam(model.parameters(),lr=0.01)\n",
    "    crit = nn.BCELoss()\n",
    "    for _ in range(300):\n",
    "        opt.zero_grad()\n",
    "        loss = crit(model(x),y)\n",
    "        loss.backward()\n",
    "        opt.step()\n",
    "    acc = ((model(x) > 0.5).float() == y).float().mean()\n",
    "    print(f\"{name}: 准确率 = {acc.item():.4f}\")\n"
   ],
