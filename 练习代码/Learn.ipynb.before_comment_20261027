    "np.random.seed(42)\n",
    "# ========== 1. 造数据：真实关系是 y = 2.5x + 1，加点噪声 ==========\n",
    "N = 200\n",
    "x = np.random.rand(N)*10#随机生成200个0~10之间的数\n",
    "true_w,true_b = 2.5,1.0\n",
    "y = true_w * x + true_b + np.random.randn(N) * 1.5#加噪声\n",
    "# ========== 2. 初始化参数（随便给个数）==========\n",
    "w = 0.0\n",
    "b = 0.0\n",
    "lr = 0.01\n",
    "losses = []\n",
    "# ========== 3. 训练循环 ==========\n",
    "for epoch in range(1000):\n",
    "    # --- 前向：算预测 ---\n",
    "    y_pred = w*x+b\n",
    "    # --- 算损失 ---\n",
    "    error = y_pred - y\n",
    "    loss = np.mean(error ** 2)#np.mean(...)求平均 = 总数/个数，用数学写出来就是： loss = (1/N) × Σ eᵢ²\n",
    "    # --- 反向：算梯度(上面推的公式) ---\n",
    "    dw = (2 / N) * np.sum(error * x)#损失函数的由来\n",
    "    db = (2 / N) * np.sum(error)#损失函数的由来\n",
    "    # --- 更新参数 ---\n",
    "    w = w - lr*dw\n",
    "    b = b - lr*db\n",
    "    if epoch % 100 ==0:\n",
    "        print(f\"epoch{epoch:4d} loss={loss:9.4f} w={w:7.4f} b={b:7.4f}\")\n",
    "print(f\"\\n学到的: w={w:.4f} b={b:.4f}\")\n",
