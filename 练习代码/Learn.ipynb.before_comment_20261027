    "import torch\n",
    "import torch.nn as nn\n",
    "import numpy as np\n",
    "from sklearn.datasets import make_classification #使用make_classification来造数据\n",
    "torch.manual_seed(42)\n",
    "#数据\n",
    "#n_samples=2000,2000个样本\n",
    "#n_features=10，其中10个特征\n",
    "#n_informative=5，有用的特征数为5\n",
    "#random_state=42,随机参数种子42\n",
    "x,y = make_classification(n_samples=2000,n_features=10,\n",
    "                          n_informative=5,random_state=42)\n",
    "#把numpy数组复制成pytorch张量，顺便强制把类型改成float32\n",
    "#转前：numpy float64\n",
    "#转后：torch float32\n",
    "x = torch.tensor(x,dtype=torch.float32)\n",
    "y = torch.tensor(y,dtype=torch.float32).unsqueeze(1)#(N,)->(N,1)\n",
    "#模型\n",
    "class Net(nn.Module):#这是一个pytorch模型，继承后，能被训练，能被保存、能移动到GPU\n",
    "    def __init__(self):\n",
    "        super().__init__()  #先启动父类的初始化\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(10,32),\n",
    "            nn.ReLU(),#去掉负数\n",
    "            nn.Linear(32,16),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(16,1),\n",
    "            # 注意：这里不加 Sigmoid，输出的是原始分数（logit）\n",
    "        )\n",
    "        #把输入x交给前面的self.net处理，然后返回结果\n",
    "    def forward(self,x):\n",
    "        return self.net(x)\n",
    "model = Net()#创建一个实际可用的对象，这一步自动生成了所有权重\n",
    "#损失和优化器\n",
    "#BCEWithLogitsLoss = 二分类交叉熵 + 内部自带 Sigmoid，输入是原始分数\n",
    "#所以网络不用加 Sigmoid，也不用手动 sigmoid 再算 loss\n",
    "criterion = nn.BCEWithLogitsLoss()#二分类交叉熵（带 Sigmoid）\n",
    "optimizer = torch.optim.Adam(model.parameters(),lr = 0.01)\n",
    "#训练\n",
    "for epoch in range(300):\n",
    "    y_logit = model(x)              # N×1 的原始分数\n",
    "    loss = criterion(y_logit,y)      # 内部先 sigmoid 再算交叉熵\n",
